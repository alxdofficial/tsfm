# Cloud-burst credentials TEMPLATE — copy to cloud/.env and fill in real values.
#   cp cloud/.env.example cloud/.env   &&   chmod 600 cloud/.env   &&   edit
# cloud/.env is GITIGNORED (real secrets never get committed). This template IS committed so the
# required variables are documented and "follow the repo". Load with: set -a; . cloud/.env; set +a
#
# --- Cloudflare R2 (S3-compatible object store: data bundles, backbones, run results) ---
R2_BUCKET=gen-purp-bucket
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=<cloudflare-account-id>
AWS_ACCESS_KEY_ID=<r2-access-key-id>            # R2 S3 access key (used by aws/boto3/rclone)
AWS_SECRET_ACCESS_KEY=<r2-secret-access-key>
CF_API_TOKEN=<cloudflare-api-token>             # broader Cloudflare scope; not needed for S3 object ops
#
# --- vast.ai (GPU pod lifecycle; read automatically by the vastai CLI) ---
VAST_API_KEY=<vast-ai-api-key>
#
# --- Docker Hub (authenticated image pulls -> higher rate limits, avoids host anon-IP throttling) ---
# passed to: vastai create instance ... --login '-u $DOCKERHUB_USER -p $DOCKERHUB_TOKEN docker.io'
DOCKERHUB_USER=<docker-hub-username>
DOCKERHUB_TOKEN=<docker-hub-read-only-access-token>   # hub.docker.com -> Personal access tokens
