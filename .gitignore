# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Virtual environments
.venv/
env/
venv/

# PyInstaller
*.spec

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# VSCode and PyCharm settings
.vscode/
.idea/

# Tool state
.serena
.claude
.pytest_cache/

# Debug artifacts
debug_plots/
debug_stats
debug
debug_eval
comparison

# Cloned baseline repos (7.5 GB)
auxiliary_repos/

# PDF drafts
*.pdf

# ──────────────────────────────────────────────────
# Large binary data — ignore by extension/pattern
# Scripts, configs, docs, plots are all tracked
# ──────────────────────────────────────────────────

# Raw dataset sessions (32 GB of parquet sensor data)
data/*/sessions/
data/raw/

# Benchmark bulk data (CSVs and NumPy arrays)
benchmark_data/raw/**/*.csv
benchmark_data/processed/**/*.npy

# Cloud-burst data bundles (large tarballs staged for R2 upload)
benchmark_data/bundles/

# Secrets — R2 / vast.ai / HF credentials. NEVER commit.
.env
*.env
cloud/.env
cloud/*.env

# LanHAR pre-generated descriptions (large CSVs)
benchmark_data/processed/lanhar_descriptions/

# TSFM session symlinks (point to data/ which is ignored)
benchmark_data/processed/tsfm/

# Model checkpoints and cached classifiers
training_output/**/*.pt
test_output/**/*.pt
test_output/**/*.pkl

# Training and eval logs
*.log
*.out
test_output/**/*.log
test_output/**/*.txt

# Packaged zips for sharing
*.zip

# --- V2 cleanup: dev artifacts + regenerable outputs (2026-07) ---
data/**/debug_*.png
figures/*.pdf
figures/*.png
test_output/ablation_evaluation/
test_output/baseline_evaluation/
test_output/harth_analysis/
docs/baselines/results/

# Reference papers: keep the large PDFs/pages LOCAL; track only the citation metadata
references/**/paper.pdf
references/**/webpage.html

# Loader session-index cache (regenerable)
data/.cache/
# Data-QA plots (regenerable via datascripts/shared/plot_sessions.py)
test_output/data_qa/
